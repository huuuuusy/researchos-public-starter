{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researchos-result-envelope-v1.schema.json",
  "title": "ResearchOS ResultEnvelope v1",
  "description": "A machine-run projection whose result mode is answer, artifact, or writeback. Reported artifacts and candidate references are not authority or validation claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "client_request_id", "task_id", "run_id", "runtime_scope", "status",
    "result_mode", "result", "provider_snapshot", "timing", "usage", "error_ref", "warnings"
  ],
  "properties": {
    "schema_id": {"const": "researchos-result-envelope-v1"},
    "client_request_id": {"type": "string", "maxLength": 160},
    "task_id": {"type": "string", "maxLength": 80},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "runtime_scope": {"enum": ["private", "public_starter", "personal_vault"]},
    "status": {"const": "completed"},
    "result_mode": {"enum": ["answer", "artifact", "writeback"]},
    "result": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "text"],
          "properties": {"kind": {"const": "answer"}, "text": {"type": "string", "maxLength": 24000}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "text", "reported_refs"],
          "properties": {
            "kind": {"const": "artifact"}, "text": {"type": "string", "maxLength": 24000},
            "reported_refs": {"type": "array", "maxItems": 40, "items": {
              "type": "object", "additionalProperties": false, "required": ["kind", "ref", "state"],
              "properties": {"kind": {"type": "string", "maxLength": 40}, "ref": {"type": "string", "maxLength": 2048}, "state": {"const": "reported"}}
            }}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "text", "candidate_refs"],
          "properties": {
            "kind": {"const": "writeback"}, "text": {"type": "string", "maxLength": 24000},
            "candidate_refs": {"type": "array", "maxItems": 40, "items": {
              "type": "object", "additionalProperties": false, "required": ["ref", "state"],
              "properties": {"ref": {"type": "string", "maxLength": 240}, "state": {"const": "reported"}}
            }}
          }
        }
      ]
    },
    "provider_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "reasoning_effort", "task_complexity"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 120},
        "model": {"type": "string", "maxLength": 240},
        "reasoning_effort": {"type": "string", "maxLength": 80},
        "task_complexity": {"type": "string", "maxLength": 80}
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["created_at", "started_at", "finished_at", "seconds"],
      "properties": {
        "created_at": {"type": "string", "maxLength": 80},
        "started_at": {"type": "string", "maxLength": 80},
        "finished_at": {"type": "string", "maxLength": 80},
        "seconds": {"type": "number", "minimum": 0}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "error_ref": {"type": ["string", "null"], "maxLength": 96, "pattern": "^error:(server:[0-9a-f]{64}|client:[0-9a-f]{32})$"},
    "warnings": {"type": "array", "maxItems": 8, "items": {"$ref": "researchos-error-envelope-v1.schema.json"}}
  },
  "allOf": [
    {
      "if": {"properties": {"result_mode": {"const": "answer"}}, "required": ["result_mode"]},
      "then": {"properties": {"result": {"properties": {"kind": {"const": "answer"}}}}}
    },
    {
      "if": {"properties": {"result_mode": {"const": "artifact"}}, "required": ["result_mode"]},
      "then": {"properties": {"result": {"properties": {"kind": {"const": "artifact"}}}}}
    },
    {
      "if": {"properties": {"result_mode": {"const": "writeback"}}, "required": ["result_mode"]},
      "then": {"properties": {"result": {"properties": {"kind": {"const": "writeback"}}}}}
    }
  ]
}
