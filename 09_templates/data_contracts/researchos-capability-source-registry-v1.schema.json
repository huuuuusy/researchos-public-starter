{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researchos-capability-source-registry-v1.schema.json",
  "title": "ResearchOS Capability Source Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "version", "candidates"],
  "properties": {
    "schema_id": {"const": "researchos-capability-source-registry-v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "url", "version", "license", "reuse_mode", "status", "retrieved_on", "note"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "kind": {"enum": ["skill", "repository", "paper", "workflow"]},
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "version": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "reuse_mode": {"enum": ["reference_only", "adapted", "composed"]},
          "status": {"enum": ["reference_only", "under_review", "promoted", "rejected", "superseded"]},
          "retrieved_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
