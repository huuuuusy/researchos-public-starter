                "docs/reference/SAFE_EXPORT_POLICY.zh.md"
              ]
            }
          },
          "locales": {
            "en": {
              "name": "System evolution review",
              "goal": "Diagnose maintenance pressure and propose the smallest governed change supported by real use evidence.",
              "user_input_hint": "Describe the maintenance pain, recent repository change, or real task that exposed a system gap.",
              "output": "bounded diagnosis + affected owners + candidate change + validation and rollback + confirmation boundary",
              "next_steps": [
                "Inspect the smallest relevant maintenance context",
                "Separate reproducible refresh from governance change",
                "Confirm, defer, or reject the candidate"
              ]
            },
            "zh-CN": {
              "name": "系统进化审计",
              "goal": "根据真实使用证据诊断维护压力，并提出最小、受治理的系统候选改动。",
              "user_input_hint": "说明维护摩擦、最近的仓库变化，或暴露系统缺口的真实任务。",
              "output": "有边界的诊断 + 受影响 owner + 候选改动 + 验证与回滚 + 确认边界",
              "next_steps": [
                "读取最小相关维护上下文",
                "区分可再生刷新与治理变更",
                "确认、延后或拒绝候选"
              ]
            }
          }
        }
      }
    ],
    "actions": [
