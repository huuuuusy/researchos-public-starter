{
  "schema_id": "researchos-task-extension-v2",
  "id": "deadline_warning",
  "version": "1.0.0",
  "family": "time_elapsed",
  "kind": "maintenance",
  "evaluates": [
    "commitments"
  ],
  "scope_selector": "own_scope",
  "summary_zh": "活跃承诺的截止日在 7 天内或已过期。",
  "summary_en": "An active commitment is due within 7 days or overdue.",
  "trigger": {
    "when": "due_date_within_days",
    "days": 7,
    "states": [
      "mainline",
      "waiting",
      "queued",
      "conditional"
    ]
  },
  "preserve": [
    "all_content"
  ],
  "expect": {
    "result": "decision",
    "write_scope": []
  },
  "pre": {
    "auto_start_max": "internal"
  },
  "executor": "script",
  "resolver": "human",
  "check": [
    "due_date_outside_window_or_commitment_inactive"
  ],
  "budget": {
    "model_runs": 0
  },
  "available_in": [
    "private",
    "public_starter"
  ]
}
